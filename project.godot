; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ECOS"
config/version="1.0.0"
run/main_scene="res://Scenes/UI/ClicParaEmpezar.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.117647, 0.105882, 0.180392, 1)
boot_splash/use_filter=false
boot_splash/image="res://Assets/UI/fondo_titulo.png"
config/icon="res://icon.svg"

[audio]

general/default_playback_type.web=0

[autoload]

GameState="*uid://l6tdsafb5sht"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Dialogo="*uid://bhf8rrh0owlqe"
Notificacion="*res://Autoload/Notificacion.gd"
Habilidades="*res://Autoload/Habilidades.gd"
Opciones="*res://Autoload/Opciones.gd"
Sonido="*res://Autoload/Sonido.gd"
Guardado="*res://Autoload/Guardado.gd"
Menus="*res://Autoload/Menus.gd"
Evaluacion="*res://Autoload/Evaluacion.gd"
Depuracion="*res://Autoload/Depuracion.gd"
Reportes="*res://Autoload/Reportes.gd"

[dialogue_manager]

runtime/balloon_path="res://Scenes/UI/DialogoBalloon.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/stretch/scale_mode.web="fractional"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

