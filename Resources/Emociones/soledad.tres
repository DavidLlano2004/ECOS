[gd_resource type="Resource" script_class="EmocionData" format=3]

[ext_resource type="Script" path="res://Scripts/Datos/EmocionData.gd" id="1_emocion"]

[resource]
script = ExtResource("1_emocion")
id = "soledad"
orden = 4
nombre = "Soledad"
descripcion_corta = "Una criatura tímida que solo se acerca si esperas en calma. Quiere compañía, pero no sabe pedirla."
color = Color(0.373, 0.541, 0.545, 1)
habilidad_id = "vinculo"
habilidad_nombre = "Vínculo"
habilidad_descripcion = "Un compañero que ayuda en mecanismos dobles."
comportamiento = 3
velocidad = 40.0
mensaje_integracion = "Pedir compañía no es debilidad. Los vínculos te sostienen."
mensaje_fallo = "La soledad se queda a lo lejos. Nadie se acercó, y ella tampoco se atrevió."
mensaje_presente_aliada = "Ahora no vas solo. Tu compañero te ayuda donde hacen falta dos manos."
mensaje_presente_bloqueo = "Hay mecanismos que no se mueven con una sola persona. La soledad sigue esperando que alguien se acerque."
