[ext_resource type="SpriteFrames" path="res://Resources/Emociones/frames_tristeza.tres" id="2_frames"]

[resource]
script = ExtResource("1_emocion")
id = "tristeza"
orden = 3
nombre = "Tristeza"
descripcion_corta = "Una criatura lenta que camina sin rumbo. Carga algo pesado que no ha podido soltar."
color = Color(0.31, 0.525, 0.776, 1)
habilidad_id = "calma"
habilidad_nombre = "Calma"
habilidad_descripcion = "Devuelve el agua y la vida."
comportamiento = 2
velocidad = 25.0
frames = ExtResource("2_frames")
mensaje_integracion = "Llorar también es sanar. Lo que se siente, se suelta."
mensaje_fallo = "La tristeza sigue su camino, sola. En el Presente, el agua se aleja un poco más."
mensaje_presente_aliada = "La tristeza ahora te enseña a soltar. Donde pasa, vuelve el agua y crece la vida."
mensaje_presente_bloqueo = "Todo está seco y quieto. La tristeza necesita que alguien se quede a escucharla."
frase_cierre = "Tómate tu tiempo."
mensaje_presente_atacada = "La lluvia cae con furia sobre un estanque lleno de grietas. Lo que se aparta a la fuerza duele más."
mensaje_presente_ignorada = "El estanque se secó del todo y la nube nunca se va. Nadie se sentó a su lado."
