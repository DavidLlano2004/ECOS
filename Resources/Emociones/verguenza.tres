[gd_resource type="Resource" script_class="EmocionData" format=3]

[ext_resource type="Script" path="res://Scripts/Datos/EmocionData.gd" id="1_emocion"]
[ext_resource type="SpriteFrames" path="res://Resources/Emociones/frames_verguenza.tres" id="2_frames"]

[resource]
script = ExtResource("1_emocion")
id = "verguenza"
orden = 7
nombre = "Vergüenza"
descripcion_corta = "Una criatura tímida cubierta con una tela. Se esconde si la miras fijamente, pero se queda si te acercas de lado."
color = Color(0.788, 0.467, 0.42, 1)
habilidad_id = "revelar"
habilidad_nombre = "Revelar"
habilidad_descripcion = "Muestra caminos, puentes y puertas ocultos"
comportamiento = 6
velocidad = 30.0
frames = ExtResource("2_frames")
mensaje_integracion = "La vergüenza dice que te importa lo que otros piensan. Si la miras con cariño, te deja ser tú."
mensaje_fallo = "La vergüenza se tapó la cara y se escondió todavía más. No se fue: solo se hizo más pequeña."
mensaje_presente_aliada = "Una pequeña guía encapuchada camina a tu lado y te muestra lo que estaba oculto: un puente, una puerta, un camino."
mensaje_presente_bloqueo = "Un muro de espejos cubiertos con telas te esconde el camino. Vuelve al Pasado y mírala con cariño."
frase_cierre = "Está bien. Vuelve cuando quieras."
mensaje_presente_atacada = "Las telas están rasgadas y los espejos, torcidos. La vergüenza se esconde todavía más."
mensaje_presente_ignorada = "Las telas lo cubren todo y hasta los espejos callan. Nadie se acercó a mirar con cariño."
