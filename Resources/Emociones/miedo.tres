[gd_resource type="Resource" script_class="EmocionData" format=3]

[ext_resource type="Script" path="res://Scripts/Datos/EmocionData.gd" id="1_emocion"]

[resource]
script = ExtResource("1_emocion")
id = "miedo"
orden = 2
nombre = "Miedo"
descripcion_corta = "Una criatura temblorosa que se aleja cuando te acercas. Solo quiere sentirse a salvo."
color = Color(0.557, 0.357, 0.82, 1)
habilidad_id = "vision"
habilidad_nombre = "Visión"
habilidad_descripcion = "Permite ver y cruzar zonas oscuras."
comportamiento = 1
velocidad = 55.0
mensaje_integracion = "El miedo no te detiene, te avisa. Con compañía, se vuelve cuidado."
mensaje_fallo = "El miedo huye más lejos. La oscuridad del Presente se siente un poco más densa."
mensaje_presente_aliada = "El miedo ahora te alumbra el camino. Ya no te paraliza: te cuida."
mensaje_presente_bloqueo = "La oscuridad no te deja pasar. El miedo sigue esperando que alguien lo acompañe."
